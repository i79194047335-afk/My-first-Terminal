# FXCM broker credentials
FXCM_LOGIN=your_login
FXCM_PASSWORD=your_password
FXCM_URL=http://www.fxcorporate.com/Hosts.jsp
FXCM_CONNECTION=Demo

# intrade.bar bot — пара, которой авторизуются ВСЕ вызовы кроме /login.
# Добывается один раз руками: залогиниться в браузере, F12 → Console →
#   console.log(user_id, user_hash)
# Cookie площадке не нужны. user_hash — ключ от аккаунта: не коммитить.
INTRADE_USER_ID=
INTRADE_USER_HASH=

# Разрешение режима live. В текущей задаче НЕ включать: конфиг сам по себе
# режим live не пропустит, нужна и эта переменная со значением yes.
# INTRADE_ALLOW_LIVE=no
